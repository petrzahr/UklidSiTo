# ==============================================================================
# UklidSiTo – Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local to configure the application.
# Configure these variables in Vercel Project Settings for Production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION URL
# ------------------------------------------------------------------------------
# Base URL of the application.
# Production: https://uklidsito.byzahr.app
APP_BASE_URL=https://uklidsito.byzahr.app

# ------------------------------------------------------------------------------
# 2. ADMINISTRATOR AUTHENTICATION (Google Identity Services)
# ------------------------------------------------------------------------------
# Only this single Google account email will be allowed to log into the admin UI.
# Any other Google account will be strictly rejected.
ADMIN_EMAIL=your-admin-email@example.com

# Google Cloud OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Add https://<APP_BASE_URL> to Authorized JavaScript Origins.
# NO redirect URIs are needed – Google Identity Services uses the popup flow.
# NO client secret is needed – token verification uses the public Google certificates.
# Note: Use NEXT_PUBLIC_ prefix so it is available to the browser bundle.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Session signing secret (generate with: openssl rand -base64 32)
# Used to HMAC-sign the HttpOnly session cookie. Min 32 characters.
SESSION_SECRET=generate-a-secure-random-secret-at-least-32-chars-long

# ------------------------------------------------------------------------------
# 3. GOOGLE SHEETS STORAGE
# ------------------------------------------------------------------------------
GOOGLE_SHEET_ID_PROD=your-production-google-spreadsheet-id

# Google Cloud Service Account for server-side Google Sheets & Drive API access
# Share the production spreadsheet with this service account email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-gcp-project.iam.gserviceaccount.com

# Service account private key (include entire string starting with -----BEGIN PRIVATE KEY-----)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE (Resend)
# ------------------------------------------------------------------------------
# Resend API Key (from https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key

# Sender address (must be a verified domain in Resend)
EMAIL_FROM=UklidSiTo <uklid@uklidsito.byzahr.app>
